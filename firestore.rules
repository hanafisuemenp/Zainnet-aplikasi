rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection and all subcollections (quotas, documents, purchases, favorites, loyalty)
    match /users/{userId} {
      allow read, write: if true;
      
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // Global transactions collection for order logging and Admin verification
    match /transactions/{trxId} {
      allow read, write: if true;
    }

    // Permanent Nota Hardcover orders and thesis uploads
    match /nota_orders/{orderId} {
      allow read, write: if true;
    }

    // Global application settings (roles, dynamic prices, QRIS and bank account configurations)
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Accounts created by admin or registered directly
    match /auth_accounts/{accId} {
      allow read, write: if true;
    }

    // Anti-Abuse: Device and IP trial records
    match /device_trials/{deviceHash} {
      allow read, write: if true;
    }

    match /ip_trials/{ipHash} {
      allow read, write: if true;
    }

    // Daily Web Traffic & Visitor Analytics (Page Views & Unique User Views)
    match /daily_stats/{dateId} {
      allow read, write: if true;
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // Blog posts & Makalah repository
    match /posts/{postId} {
      allow read, write: if true;
    }

    // Health check test connection
    match /test/{testId} {
      allow read, write: if true;
    }
  }
}

